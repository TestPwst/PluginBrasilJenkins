pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/TestPwst/PluginBrasilJenkins.git/'
    }

    stages {
        stage('1. Checkout') {
            steps {
                git branch: '5.2.X.X', url: "${env.REPO_URL}"
            }
        }

        stage('2. Setup Python & Deps') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('3. Start Appium Server') {
            steps {
                // Iniciamos Appium en segundo plano.
                sh 'appium --log appium_server.log & sleep 10'
            }
        }

        stage('4. Run Automated Tests') {
            steps {
                script {
                    try {
                        sh '''
                            . venv/bin/activate
                            pytest Brasil/FLUJOS/ --junitxml=reporte_pruebas.xml
                        '''
                    } catch (Exception e) {
                        currentBuild.result = 'FAILURE'
                        echo "Las pruebas fallaron. Iniciando limpieza..."
                    }
                }
            }
        }
    }

    post {
        always {
               // 1. Se detiene Appium en Windows
            sh 'pkill -f node || echo "Appium no estaba corriendo"'

            // 2 Publicar resultados
            junit 'reporte_pruebas.xml'

            // 3. Guardar el logs
            archiveArtifacts artifacts: 'appium_server.log', allowEmptyArchive: true
        }
    }
}